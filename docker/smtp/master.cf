# Configuração master do Postfix

# Serviço pickup (necessário para postdrop/sendmail funcionar)
pickup    unix  n       -       n       60      1       pickup

# Serviço rewrite (socket private/rewrite — o cleanup depende dele; daemon trivial-rewrite)
rewrite    unix  -       -       n       -       -       trivial-rewrite

# Serviço cleanup (recebe de pickup, injeta na fila — usa trivial-rewrite para endereços)
cleanup   unix  n       -       n       -       0       cleanup

# Serviço qmgr (gerenciador de fila - necessário para processar e-mails)
qmgr      unix  n       -       n       300     1       qmgr

# Serviço showq (necessário para postqueue funcionar)
showq     unix  n       -       n       -       -       showq

# Serviço virtual (entrega para domínios virtuais/Maildir)
virtual   unix  -       n       n       -       -       virtual

# defer e trace (o virtual usa para notificar status de entrega — sem eles, status=deferred "trace service failed")
defer     unix  -       -       n       -       0       defer
trace     unix  -       -       n       -       0       trace

smtp      inet  n       -       n       -       -       smtpd
submission inet n       -       y       -       -       smtpd
  -o syslog_name=postfix/submission
  -o smtpd_tls_security_level=encrypt
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_tls_auth_only=yes
  -o smtpd_reject_unlisted_recipient=no
  -o smtpd_client_restrictions=$mua_client_restrictions
  -o smtpd_helo_restrictions=$mua_helo_restrictions
  -o smtpd_sender_restrictions=$mua_sender_restrictions
  -o smtpd_recipient_restrictions=permit_sasl_authenticated,reject
  -o milter_macro_daemon_name=ORIGINATING

# Amavis (ClamAV + SpamAssassin)
amavis unix -      -       n       -       2       smtp
  -o smtp_data_done_timeout=1200
  -o smtp_send_xforward_command=yes
  -o disable_dns_lookups=yes
  -o max_use=20

127.0.0.1:10025 inet n    -       n       -       -       smtpd
  -o content_filter=
  -o local_recipient_maps=
  -o relay_recipient_maps=
  -o smtpd_restriction_classes=
  -o smtpd_delay_reject=no
  -o smtpd_client_restrictions=permit_mynetworks,reject
  -o smtpd_helo_restrictions=
  -o smtpd_sender_restrictions=
  -o smtpd_recipient_restrictions=permit_mynetworks,reject
  -o smtpd_data_restrictions=reject_unauth_pipelining
  -o smtpd_end_of_data_restrictions=
  -o mynetworks=127.0.0.0/8
  -o smtpd_error_sleep_time=0
  -o smtpd_soft_error_limit=1001
  -o smtpd_hard_error_limit=1000
  -o smtpd_client_connection_count_limit=0
  -o smtpd_client_connection_rate_limit=0
  -o receive_override_options=no_header_body_checks,no_unknown_recipient_checks
