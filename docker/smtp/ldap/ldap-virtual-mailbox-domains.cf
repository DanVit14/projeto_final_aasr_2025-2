# Configuração LDAP para domínios virtuais
# Usando LDAPS (636) diretamente - StartTLS não está funcionando
server_host = ldap
server_port = 636
version = 3
bind = yes
start_tls = no
tls_require_cert = no
timeout = 10
bind_dn = cn=Administrator,cn=Users,dc=empresa,dc=local
bind_pw = Admin@123
search_base = dc=empresa,dc=local
# Para domínios virtuais, verificar se existe usuário com o domínio
query_filter = (&(objectClass=person)(mail=*@%s))
result_attribute = mail
