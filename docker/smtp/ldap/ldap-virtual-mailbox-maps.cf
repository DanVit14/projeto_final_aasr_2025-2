# Configuração LDAP para mapeamento de caixas de correio
# PROBLEMA CONHECIDO: postmap não consegue conectar ao LDAP mesmo com ldapsearch funcionando
# Isso pode ser um bug/limitação do Postfix com LDAP em containers Docker
# 
# SOLUÇÃO ALTERNATIVA: Usar script wrapper ou documentar como limitação
# Por enquanto, mantendo configuração LDAPS (636) que é o que deveria funcionar
server_host = ldap
server_port = 636
version = 3
bind = yes
start_tls = no
tls_require_cert = no
timeout = 10
chase_referrals = no
bind_dn = cn=Administrator,cn=Users,dc=empresa,dc=local
bind_pw = Admin@123
search_base = dc=empresa,dc=local
query_filter = (&(objectClass=person)(mail=%s))
result_attribute = sAMAccountName
result_format = %d/%s/Maildir/
