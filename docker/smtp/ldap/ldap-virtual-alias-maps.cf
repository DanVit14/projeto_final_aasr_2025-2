# Configuração LDAP para aliases de e-mail
# Por enquanto, retornar o próprio e-mail (aliases serão configurados manualmente)
# Usando LDAPS (636) diretamente - StartTLS não está funcionando
server_host = ldap
server_port = 636
version = 3
bind = yes
start_tls = no
tls_require_cert = no
tls_ca_cert_file = /etc/ssl/certs/ca-certificates.crt
bind_dn = cn=Administrator,cn=Users,dc=empresa,dc=local
bind_pw = Admin@123
search_base = dc=empresa,dc=local
query_filter = (&(objectClass=person)(mail=%s))
result_attribute = mail
