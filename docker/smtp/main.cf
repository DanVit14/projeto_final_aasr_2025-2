# Configuração do Postfix com LDAP/AD e Antivírus

# Identificação do servidor
myhostname = mail.empresa.local
mydomain = empresa.local
myorigin = $mydomain

# Interfaces de rede
inet_interfaces = all
inet_protocols = ipv4

# Destinos locais
mydestination = $myhostname, localhost.$mydomain, localhost

# Domínio virtual (Maildir)
# Usando scripts wrapper externos devido a problema conhecido com postmap/LDAP em containers Docker
# Referência: https://github.com/docker-mailserver/docker-mailserver/issues/1468
virtual_mailbox_domains = external:/usr/local/bin/ldap-domain.sh
virtual_mailbox_maps = external:/usr/local/bin/ldap-mailbox.sh
virtual_alias_maps = external:/usr/local/bin/ldap-alias.sh
virtual_mailbox_base = /var/mail/vhosts
virtual_minimum_uid = 100
virtual_uid_maps = static:5000
virtual_gid_maps = static:5000

# Maildir
virtual_mailbox_limit = 104857600
virtual_transport = virtual

# Autenticação SASL para envio
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_auth_enable = yes
smtpd_sasl_security_options = noanonymous
smtpd_sasl_local_domain = $mydomain
broken_sasl_auth_clients = yes

# Autenticação LDAP para SASL
# Usando script wrapper externo
smtpd_sender_login_maps = external:/usr/local/bin/ldap-sender.sh

# Restrições de recebimento
smtpd_recipient_restrictions = 
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_non_fqdn_recipient,
    reject_unknown_recipient_domain,
    permit

smtpd_helo_restrictions = 
    permit_mynetworks,
    permit_sasl_authenticated,
    warn_if_reject reject_non_fqdn_helo_hostname,
    reject_invalid_helo_hostname,
    permit

smtpd_sender_restrictions = 
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_non_fqdn_sender,
    reject_unknown_sender_domain,
    permit

# Integração com Amavis (ClamAV + SpamAssassin)
# Comentado temporariamente para debug - descomentar quando Amavis estiver funcionando
# content_filter = amavis:[127.0.0.1]:10024

# Configurações de transporte
relayhost =
mynetworks = 127.0.0.0/8, 10.0.1.0/24

# Logging
mailbox_command = /usr/lib/dovecot/deliver
mailbox_size_limit = 0
message_size_limit = 10485760

# Segurança
smtpd_tls_cert_file = /etc/ssl/certs/ssl-cert-snakeoil.pem
smtpd_tls_key_file = /etc/ssl/private/ssl-cert-snakeoil.key
smtpd_use_tls = yes
smtpd_tls_auth_only = yes
smtpd_tls_security_level = may

# Headers (comentado - arquivo não necessário para funcionamento básico)
# mime_header_checks = regexp:/etc/postfix/mime_header_checks

# Restrições para MUA (Mail User Agent) - usadas no master.cf
mua_client_restrictions = permit_mynetworks, permit_sasl_authenticated, reject
mua_helo_restrictions = permit_mynetworks, permit_sasl_authenticated, warn_if_reject reject_non_fqdn_helo_hostname, reject_invalid_helo_hostname, permit
mua_sender_restrictions = permit_mynetworks, permit_sasl_authenticated, reject_non_fqdn_sender, reject_unknown_sender_domain, permit
