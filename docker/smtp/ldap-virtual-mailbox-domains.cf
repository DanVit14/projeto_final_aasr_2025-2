# Configuração LDAP para domínios virtuais
server_host = ldap
server_port = 636
version = 3
bind = yes
start_tls = yes
tls_require_cert = no
bind_dn = cn=Administrator,cn=Users,dc=empresa,dc=local
bind_pw = Admin@123
search_base = dc=empresa,dc=local
query_filter = (&(objectClass=organizationalUnit)(ou=%s))
result_attribute = ou
